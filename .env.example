# Copy this file to .env.local (for local `vercel dev`) and fill in real
# values there, or set these in your host's dashboard (Vercel: Project
# Settings -> Environment Variables). Never commit real values — .env* is
# already in .gitignore.
#
# Where to find these: Square Developer Dashboard
# (https://developer.squareup.com/apps) -> your application.

# "sandbox" while testing, "production" once you're ready to take real
# payments. Controls both which Square API host the server calls and
# which Web Payments SDK script the browser loads.
SQUARE_ENVIRONMENT=sandbox

# Application ID (safe to expose client-side — not a secret). Sandbox and
# production applications have different IDs; use the one matching
# SQUARE_ENVIRONMENT above.
SQUARE_APPLICATION_ID=sandbox-sq0idb-XXXXXXXXXXXXXXXXXXXXXX

# Access token (SECRET — server-side only, never sent to the browser).
# Square Dashboard -> your app -> Credentials.
SQUARE_ACCESS_TOKEN=EAAAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Location ID for the studio (Square Dashboard -> your app -> Locations).
SQUARE_LOCATION_ID=LXXXXXXXXXXXX

# Optional. Your Square Appointments hosted booking-site link (Square
# Dashboard -> Appointments -> Online Booking -> Booking Site). Embeds live
# scheduling on book-online.html once set; that page stays a placeholder
# until it is.
SQUARE_BOOKING_URL=https://book.squareup.com/appointments/xxxxxxxx
